# Скопируйте в .env и заполните значения

TOKEN=your_telegram_bot_token
ADMIN_IDS=123456789

# База (пусто = авто: data/bot.db или /app/data/bot.db на BotHost)
# DB_PATH=/app/data/bot.db

# Интервалы опроса, секунды
# CHECK_INTERVAL — тик цикла (не длиннее VIP). VIP ~30с, обычные ~7 мин.
CHECK_INTERVAL=10
VIP_CHECK_INTERVAL=30
REGULAR_CHECK_INTERVAL=420

# Retention цен для средней рыночной (дней)
PRICE_DATA_RETENTION_DAYS=14

# Kufar
KUFAR_SIZE=40
KUFAR_MAX_PAGES=2
# Каталожный поиск (модель+память+частник). false = старые текстовые KUFAR_QUERIES
KUFAR_USE_CATALOG=true
# KUFAR_CATALOG_COMPARE=true
MARKET_DISCOUNT_THRESHOLD=0.85

# VIP «Идеальные (бета)»: минимальный явный % АКБ в описании
IDEAL_MIN_BATTERY_PERCENT=75
# IDEAL_ALLOWED_CONDITIONS=Отличное,Хорошее

# Retention просмотренных объявлений (дней)
SEEN_ADS_RETENTION_DAYS=90

# Логи: INFO | DEBUG
LOG_LEVEL=INFO

# SQLITE_SYNCHRONOUS=NORMAL
# REFERRAL_VIP_DAYS_PER_FRIEND=1
